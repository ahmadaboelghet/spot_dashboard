rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isTeacherOwner(teacherId) {
      return request.auth != null && 
             request.auth.token.email == teacherId[1:teacherId.size()] + '@spot.com';
    }
    
    function isParent() {
      return request.auth != null && 
             request.auth.token.email.matches('.*@learnaria[.]app');
    }

    match /teachers/{teacherId} {
      allow read: if isTeacherOwner(teacherId) || isParent();
      allow write: if isTeacherOwner(teacherId);
      
      match /{allSubcollections=**} {
        allow read: if isTeacherOwner(teacherId) || isParent();
        allow write: if isTeacherOwner(teacherId);
      }
    }

    match /parents/{phoneNumber} { 
      allow read, write: if request.auth != null; 
    }
    match /users/{userId} { 
      allow read, write: if request.auth != null; 
    }
    
    match /{path=**}/students/{studentId} {
      allow read, write: if request.auth != null;
    }
  }
}